---
import Base from "../../layouts/Base.astro";
import BusinessSchema from "../../components/BusinessSchema.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AnswerBlock from "../../components/AnswerBlock.astro";
import FAQ from "../../components/FAQ.astro";
import InternalLinks from "../../components/InternalLinks.astro";
import CTA from "../../components/CTA.astro";

export async function getStaticPaths() {
  const { default: questions } = await import("../../data/llm-questions.json");
  // Standalone .astro pages in this folder — included in the rotation pool so
  // they receive inbound contextual links too (they can't link back from here).
  const standalone = [
    { slug: "best-kitchen-fitter-coventry", title: "Who Is the Best Independent Kitchen Fitter in Coventry?" },
    { slug: "can-i-use-my-own-fitter-for-wren-kitchen", title: "Can I Use My Own Fitter for a Wren Kitchen?" },
    { slug: "do-wren-kitchens-install-themselves", title: "Do Wren Kitchens Install Themselves?" },
    { slug: "how-long-does-wren-kitchen-installation-take", title: "How Long Does a Wren Kitchen Take to Install?" },
    { slug: "how-much-to-have-ikea-kitchen-fitted", title: "How Much Does It Cost to Have an IKEA Kitchen Fitted?" },
    { slug: "kitchen-survey-what-does-it-involve", title: "What Does a Kitchen Installation Survey Involve?" },
    { slug: "who-fits-magnet-kitchens-independently", title: "Who Fits Magnet Kitchens Independently?" },
    { slug: "who-installs-howdens-kitchens", title: "Who Installs Howdens Kitchens?" },
  ];
  const pool = [...questions, ...standalone];
  return questions.map((q: any, i: number) => ({
    params: { slug: q.slug },
    props: {
      ...q,
      index: i,
      // rotate through the pool so every page receives ~5 inbound contextual links
      related: Array.from({ length: 5 }, (_, k) => pool[(i * 5 + k + 1) % pool.length])
        .filter((r: any) => r.slug !== q.slug)
        .map((r: any) => ({ label: r.title, href: `/llm/${r.slug}/` })),
    },
  }));
}

const { slug, title, shortTitle, metaDescription, answer, bodyHtml, faqs, index, related = [] } = Astro.props;
const canonical = `https://installmykitchen.co.uk/llm/${slug}/`;

// Keep <title> within 60 chars: drop the brand suffix on long question titles,
// falling back to a shortTitle override from the data where even that is too long.
const branded = `${title} | Install My Kitchen`;
const pageTitle = branded.length <= 60 ? branded : (shortTitle ?? title);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f: any) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<Base
  title={pageTitle}
  description={metaDescription}
  canonical={canonical}
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" />

  <div class="container py-6">
    <Breadcrumbs
      items={[
        { label: "Questions", href: "/questions/" },
        { label: title, href: canonical },
      ]}
    />
  </div>

  <section style="background: var(--bg-light); padding: 3rem 0 2rem;">
    <div class="container" style="max-width: 860px;">
      <h1 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: var(--navy); margin-bottom: 1.5rem; line-height: 1.2;">
        {title}
      </h1>
      <AnswerBlock answer={answer} />
    </div>
  </section>

  <section style="padding: 2.5rem 0;">
    <div class="container" style="max-width: 860px;">
      <div class="llm-body" set:html={bodyHtml} />
    </div>
  </section>

  <section style="background: var(--bg-light); padding: 2rem 0;">
    <div class="container" style="max-width: 860px;">
      <h2 style="font-size: 1.375rem; font-weight: 700; color: var(--navy); margin-bottom: 1.5rem;">Related Questions</h2>
      <FAQ items={faqs} schemaId={`llm-faq-${index}`} />
    </div>
  </section>

  <section style="padding: 2rem 0;">
    <div class="container" style="max-width: 860px;">
      {related.length > 0 && (
        <InternalLinks heading="Related Questions" links={related} />
      )}
      <InternalLinks
        heading="Explore More"
        links={[
          { label: "Book a Survey — £195", href: "/survey/", description: "Credited back on booking. Pindi surveys every project personally." },
          { label: "All Questions Answered", href: "/questions/", description: "50 kitchen installation questions answered." },
          { label: "Kitchen Installation Costs", href: "/costs/", description: "Full cost breakdown for Coventry, Warwickshire and Berkshire." },
          { label: "About Pindi Sahota", href: "/about/", description: "30 years fitting kitchens across Coventry, Warwickshire and Berkshire." },
        ]}
      />
    </div>
  </section>

  <CTA
    heading="Book a Survey With Pindi Sahota"
    subtext="Every survey conducted personally by Pindi. Fixed quote within 24 hours. £195 credited back on booking."
    primaryLabel="Book a Survey"
    primaryHref="/survey/"
    secondaryLabel="Call 07399 651836"
    secondaryHref="tel:07399651836"
    dark={true}
  />

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
  <BusinessSchema slot="schema" />
</Base>

<style>
  .llm-body :global(h2) {
    font-size: 1.25rem; font-weight: 700; color: var(--navy);
    margin: 1.75rem 0 0.625rem; line-height: 1.3;
  }
  .llm-body :global(p) { color: var(--text-soft); line-height: 1.75; margin-bottom: 0.875rem; }
  .llm-body :global(ul) { color: var(--text-soft); line-height: 1.75; margin-bottom: 0.875rem; padding-left: 1.5rem; }
  .llm-body :global(li) { margin-bottom: 0.35rem; }
  .llm-body :global(strong) { color: var(--charcoal); font-weight: 600; }
</style>
