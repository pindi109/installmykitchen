---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import WhatHappensNext from "../components/WhatHappensNext.astro";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://installmykitchen.co.uk/#business",
  name: "Install My Kitchen",
  url: "https://installmykitchen.co.uk",
  telephone: "07399651836",
  email: "info@installmykitchen.co.uk",
  address: {
    "@type": "PostalAddress",
    streetAddress: "242 Hollyfast Road, Coundon",
    addressLocality: "Coventry",
    addressRegion: "West Midlands",
    postalCode: "CV6 2AH",
    addressCountry: "GB",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "08:00",
      closes: "18:00",
    },
  ],
  sameAs: ["https://facebook.com/installmykitchenuk"],
};
---

<Base
  title="Contact Install My Kitchen | Coventry CV6 2AH"
  description="Contact Install My Kitchen in Coventry. Call 07399 651836, email info@installmykitchen.co.uk or fill in our form. Based at 242 Hollyfast Road, CV6 2AH."
  canonical="https://installmykitchen.co.uk/contact/"
>
  <!-- Schema -->
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Header -->
  <Header slot="header" />

  <!-- ══════════════════════════════ PAGE HEADER ══════════════════ -->
  <section class="page-header" aria-label="Page header">
    <div class="container">
      <Breadcrumbs items={[{ label: "Contact", href: "/contact/" }]} />
      <h1 class="page-h1">Contact Install My Kitchen</h1>
      <p class="page-sub">Get in touch to book a survey, ask about our services, or check available installation dates across Coventry, Warwickshire and Berkshire.</p>
    </div>
  </section>

  <!-- ══════════════════════════════ CONTACT CONTENT ═══════════ -->
  <section class="section" style="background: #fff;" aria-label="Contact details and enquiry form">
    <div class="container">
      <div class="contact-grid">

        <!-- Left: NAP + hours + map -->
        <div class="contact-info">

          <!-- NAP card -->
          <div class="nap-card" itemscope itemtype="https://schema.org/LocalBusiness">
            <h2 class="nap-heading">Get in Touch</h2>

            <address class="nap-address not-italic">
              <div class="nap-row">
                <span class="nap-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <div>
                  <p class="nap-label">Address</p>
                  <p class="nap-value" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                    <span itemprop="streetAddress">242 Hollyfast Road, Coundon</span><br />
                    <span itemprop="addressLocality">Coventry</span>,
                    <span itemprop="postalCode">CV6 2AH</span>
                  </p>
                </div>
              </div>

              <div class="nap-row">
                <span class="nap-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <div>
                  <p class="nap-label">Phone</p>
                  <a href="tel:07399651836" class="nap-link" itemprop="telephone">07399 651836</a>
                </div>
              </div>

              <div class="nap-row">
                <span class="nap-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </span>
                <div>
                  <p class="nap-label">Email</p>
                  <a href="mailto:info@installmykitchen.co.uk" class="nap-link" itemprop="email">info@installmykitchen.co.uk</a>
                </div>
              </div>

              <div class="nap-row">
                <span class="nap-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <div>
                  <p class="nap-label">Business Hours</p>
                  <p class="nap-value">Monday – Saturday: 8am – 6pm</p>
                  <p class="nap-value nap-closed">Sunday: Closed</p>
                </div>
              </div>
            </address>

            <!-- Quick action links -->
            <div class="nap-actions">
              <a href="tel:07399651836" class="btn-primary nap-action-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Call Now
              </a>
              <a href="mailto:info@installmykitchen.co.uk" class="btn-secondary nap-action-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                Send Email
              </a>
            </div>
          </div>

          <!-- Map placeholder -->
          <div class="map-placeholder" aria-label="Map location placeholder" role="img">
            <div class="map-inner">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--teal); opacity: 0.5;">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <p class="map-label">242 Hollyfast Road, Coundon, Coventry CV6 2AH</p>
              <a
                href="https://maps.google.com/?q=242+Hollyfast+Road,+Coventry,+CV6+2AH"
                target="_blank"
                rel="noopener noreferrer"
                class="map-link"
              >
                Open in Google Maps
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>

        </div>

        <!-- Right: enquiry form -->
        <div id="quote" class="contact-form">
          <EnquiryForm formTitle="Send Us a Message" showSurveyOption={true} />
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ CONTACT PROCESS DETAIL ═══════ -->
  <section class="section" style="background: var(--bg-light);" aria-label="What to expect when you contact us">
    <div class="container">
      <div class="max-w-3xl">

        <h2 class="text-2xl font-bold mb-4" style="color: var(--navy);">What to Expect When You Contact Us</h2>
        <p class="mb-4" style="color: var(--charcoal); line-height: 1.75;">
          However you reach us — by phone, email or the form on this page — enquiries are handled personally; there is no call centre and no automated triage. Call during business hours and you will speak directly to Pindi or a member of the small team who can discuss your kitchen there and then. Emails and form submissions are read and answered within one working day, usually sooner. If you contact us outside business hours, leave a message or send an email and we will come back to you at the latest by the next working day.
        </p>

        <h2 class="text-2xl font-bold mb-4 mt-8" style="color: var(--navy);">What to Have Ready When You Request a Quote</h2>
        <p class="mb-4" style="color: var(--charcoal); line-height: 1.75;">
          A faster, more accurate response usually depends on a handful of details. Before you get in touch, it helps to have to hand:
        </p>
        <ul class="mb-4" style="color: var(--charcoal); line-height: 1.75; padding-left: 1.5rem; list-style: disc;">
          <li>Your postcode, so we can confirm we cover your area and estimate travel.</li>
          <li>The retailer or supplier your kitchen is coming from, if you have already chosen one — or let us know if you have not decided yet.</li>
          <li>A delivery date, if your kitchen has already been ordered, so we can plan the installation around it.</li>
          <li>Kitchen plans or drawings, if you have them — these can be uploaded directly through our enquiry form.</li>
          <li>Photos of the existing kitchen or room, which help us get a sense of the job ahead of the survey visit.</li>
          <li>Any structural changes you are considering, such as removing a wall or repositioning plumbing, so we know to plan for this at survey stage.</li>
        </ul>
        <p class="mb-4" style="color: var(--charcoal); line-height: 1.75;">
          None of this is required to make an enquiry — if you do not have all of it yet, contact us anyway and we will talk through what is needed.
        </p>

        <h2 class="text-2xl font-bold mb-4 mt-8" style="color: var(--navy);">How Booking a Survey Works</h2>
        <p class="mb-4" style="color: var(--charcoal); line-height: 1.75;">
          Every installation starts with a paid survey visit, currently £195, which is credited in full against your installation cost when you book. During the visit, we measure the room, check it against your kitchen plan, identify any structural or access issues, and confirm what preparation work — such as strip-out or first-fix electrics — needs to happen before your kitchen goes in. You will receive a fixed, itemised quote after the visit, so there are no surprises once work begins. If you already know your kitchen delivery date, mention it when you contact us and we will aim to book your survey and installation slots around it.
        </p>

        <h2 class="text-2xl font-bold mb-4 mt-8" style="color: var(--navy);">Confirming We Cover Your Area</h2>
        <p style="color: var(--charcoal); line-height: 1.75;">
          We cover the whole of <a href="/areas/" class="nap-link">Coventry and Warwickshire</a>, plus eight main towns across Berkshire. If your postcode is not listed on our areas page, get in touch anyway — we regularly take on installations a short distance beyond our usual areas and can confirm quickly whether we can help.
        </p>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ WHAT HAPPENS NEXT ═══════════ -->
  <WhatHappensNext />

  <!-- ══════════════════════════════ COVERAGE ════════════════════ -->
  <section class="section" style="background: var(--bg-light);" aria-label="Areas we cover">
    <div class="container">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold mb-4" style="color: var(--navy);">Where We Work</h2>
        <p class="mb-4" style="color: var(--charcoal); line-height: 1.75;">
          Install My Kitchen is based in Coundon, Coventry, and covers the whole of
          <a href="/areas/" class="nap-link">Coventry and Warwickshire</a> — including Rugby, Nuneaton,
          Leamington Spa, Kenilworth, Warwick, Solihull and Stratford-upon-Avon — as well as
          Berkshire towns including Reading, Bracknell, Slough, Maidenhead, Windsor, Wokingham,
          Newbury and Ascot. If you are unsure whether we cover your area, just ask — we regularly
          take on installations a short distance beyond these areas.
        </p>
        <p class="mb-4" style="color: var(--charcoal); line-height: 1.75;">
          We fit kitchens from every major retailer — Wren, Howdens, Magnet, IKEA, B&amp;Q, Wickes,
          Benchmarx and <a href="/retailers/" class="nap-link">more</a> — and also handle
          <a href="/repairs/" class="nap-link">repairs and remedial work</a> such as hinge, door and
          worktop replacements. For anything installation-related, the quickest route is a
          <a href="/survey/" class="nap-link">£195 pre-installation survey</a>, credited back in full
          when you book your installation.
        </p>
        <p style="color: var(--charcoal); line-height: 1.75;">
          Phone is the fastest way to reach us — call <a href="tel:07399651836" class="nap-link">07399 651836</a>
          between 8am and 6pm, Monday to Saturday. Emails and form enquiries are answered within one
          working day. If you already have a kitchen delivery date booked, let us know in your message
          so we can prioritise available installation slots around it.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>

<style>
  /* Page header */
  .page-header {
    background: var(--hero-gradient);
    padding: 3rem 0 3.5rem;
  }

  .page-h1 {
    font-size: clamp(1.625rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .page-sub {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 540px;
  }

  /* Contact grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 400px 1fr;
    }
  }

  /* NAP card */
  .nap-card {
    background: var(--bg-light);
    border: 1.5px solid var(--border);
    border-radius: 1.25rem;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .nap-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 1.5rem;
  }

  .nap-address {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .nap-row {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .nap-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: rgba(15, 118, 110, 0.1);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nap-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft);
    margin-bottom: 0.25rem;
  }

  .nap-value {
    font-size: 0.9375rem;
    color: var(--charcoal);
    line-height: 1.5;
  }

  .nap-closed {
    color: var(--text-soft);
    font-size: 0.875rem;
  }

  .nap-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--teal);
    transition: color 0.15s;
  }

  .nap-link:hover {
    color: var(--teal-bright);
  }

  .nap-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .nap-action-btn {
    flex: 1;
    justify-content: center;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* Map placeholder */
  .map-placeholder {
    border: 2px dashed var(--border);
    border-radius: 1rem;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-light);
  }

  .map-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
  }

  .map-label {
    font-size: 0.875rem;
    color: var(--text-soft);
    line-height: 1.5;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--teal);
    transition: color 0.15s;
  }

  .map-link:hover {
    color: var(--teal-bright);
  }
</style>
