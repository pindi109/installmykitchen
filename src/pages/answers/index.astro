---
import Base from "../../layouts/Base.astro";
import BusinessSchema from "../../components/BusinessSchema.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTA from "../../components/CTA.astro";

// Title matches the H1 ("Questions & Answers") so the literal word "Answers"
// appears, not just "Answered" — kept ≤60 chars by dropping the leading
// "Kitchen" (brand suffix already supplies it via "Install My Kitchen").
const title = "Installation Questions & Answers | Install My Kitchen";
const description = "Find clear answers to all your kitchen installation questions — costs, timescales, what's included, retailer fitting and more.";
const canonical = "https://installmykitchen.co.uk/answers/";

const questions = [
  {
    slug: "how-much-does-kitchen-installation-cost",
    title: "How Much Does Kitchen Installation Cost?",
    description: "UK cost ranges for small, medium and large kitchens, what affects your final quote, and why a survey is the only way to get an accurate price.",
    answer: "Kitchen installation typically costs £1,800–£7,500 depending on kitchen size, complexity and retailer. A small kitchen (8–12 units) starts from around £1,800; a large kitchen (21+ units) can reach £7,500 or more. A survey from Install My Kitchen costs £195 and is credited back in full when you proceed.",
  },
  {
    slug: "how-long-does-kitchen-installation-take",
    title: "How Long Does Kitchen Installation Take?",
    description: "Day-by-day timescales for kitchens of every size, and the key factors that can extend or shorten your installation timeline.",
    answer: "A small kitchen typically takes 3–4 days to install; a medium kitchen 4–6 days; a large kitchen 6–10 days. This assumes all deliveries are on site, services are prepared, and no structural changes are needed.",
  },
  {
    slug: "do-i-need-a-survey-before-kitchen-installation",
    title: "Do I Need a Survey Before Kitchen Installation?",
    description: "Why a pre-installation survey protects you, what our surveyors check, and how the £195 fee is credited back in full when you proceed.",
    answer: "A pre-installation survey is strongly recommended. It checks that your room matches your kitchen plan, confirms services are correctly positioned, identifies any risks, and enables an accurate fixed quote. Install My Kitchen's survey costs £195 and is credited back in full when you proceed with the installation.",
  },
  {
    slug: "what-is-a-dry-fit-kitchen",
    title: "What Is a Dry Fit Kitchen?",
    description: "What a dry fit (or trial fit) involves, when it is used, and how it prevents costly problems during permanent installation.",
    answer: "A dry fit (also called a trial fit) is when kitchen units are assembled and positioned without final fixing, allowing positions to be verified before permanent installation. It is particularly useful where walls are uneven, ceilings are low, or appliance positions need confirming.",
  },
  {
    slug: "can-you-fit-an-ikea-kitchen",
    title: "Can You Fit an IKEA Kitchen?",
    description: "Yes — we install IKEA kitchens across Coventry, Warwickshire and Berkshire. What to expect with flat-pack assembly and why it takes a little longer.",
    answer: "Yes. Install My Kitchen installs IKEA kitchens across Coventry, Warwickshire and Berkshire. IKEA kitchens are flat-pack and require careful assembly before installation, which typically adds one to two days compared to pre-assembled units. We are independent of IKEA and not affiliated with them.",
  },
  {
    slug: "can-you-fit-a-wren-kitchen",
    title: "Can You Fit a Wren Kitchen?",
    description: "Yes — we independently install Wren kitchens. Wren delivers fully assembled, making installation efficient. We are not affiliated with Wren.",
    answer: "Yes. Install My Kitchen installs Wren kitchens across Coventry, Warwickshire and Berkshire. Wren delivers kitchens fully assembled to your door, which makes the installation process efficient. We are an independent service and are not affiliated with Wren Kitchens.",
  },
  {
    slug: "can-you-fit-a-howdens-kitchen",
    title: "Can You Fit a Howdens Kitchen?",
    description: "Yes — we install Howdens kitchens from trade supply. What to expect with trade-quality units and our independent approach.",
    answer: "Yes. We install Howdens kitchens across Coventry, Warwickshire and Berkshire. Howdens supplies through trade accounts and units are trade quality and rigid. We are independent of Howdens and not affiliated with them.",
  },
  {
    slug: "can-you-fit-a-magnet-kitchen",
    title: "Can You Fit a Magnet Kitchen?",
    description: "Yes — we independently install Magnet kitchens. Well-built units typically supplied ready-assembled or in large sections.",
    answer: "Yes. We install Magnet kitchens independently across Coventry, Warwickshire and Berkshire. Magnet kitchens are rigid and well-finished. We are an independent service and not affiliated with Magnet.",
  },
  {
    slug: "what-is-included-in-kitchen-installation",
    title: "What Is Included in Kitchen Installation?",
    description: "Everything covered in our installation service — cabinets, worktops, doors, appliances, sinks, plinths, cornices, and more.",
    answer: "Our kitchen installation includes cabinet assembly and fitting, worktops, doors, drawers, panels, trims, plinths, cornices, pelmets, fillers, appliance and sink fitting, handles, and final adjustments and snagging. Optional extras include flooring, tiling and decorating.",
  },
  {
    slug: "do-i-need-a-plumber-for-kitchen-installation",
    title: "Do I Need a Plumber for Kitchen Installation?",
    description: "Yes — first and second-fix plumbing requires a qualified plumber. How to co-ordinate your trades so installation day runs smoothly.",
    answer: "Yes — you will need a qualified plumber for first and second-fix plumbing (water supply and waste connections). Due to high demand, we recommend arranging your own qualified plumbers, electricians and gas engineers before your installation date wherever possible.",
  },
  {
    slug: "how-do-i-prepare-for-kitchen-installation",
    title: "How Do I Prepare for Kitchen Installation?",
    description: "A practical checklist covering delivery, first-fix services, room clearance, and worktop measurements before installation day.",
    answer: "Before your installation date: confirm your kitchen delivery is complete and undamaged, ensure first-fix plumbing, electrical and gas work is done, clear the room and access routes, and confirm worktop measurements. Our survey covers all of this in advance.",
  },
  {
    slug: "what-is-kitchen-installation-cost-per-unit",
    title: "What Is Kitchen Installation Cost Per Unit?",
    description: "Typical per-unit costs of £120–£280, what makes individual units cost more, and how a survey gives you an accurate figure.",
    answer: "Kitchen installation typically costs £120–£280 per unit depending on cabinet type, complexity and retailer. Tall larder units and corner units take longer to fit. A survey from Install My Kitchen provides an accurate per-unit cost for your specific kitchen.",
  },
  {
    slug: "how-much-is-kitchen-labour-per-day",
    title: "How Much Is Kitchen Fitting Labour Per Day?",
    description: "Day rates for kitchen fitters in Coventry, Warwickshire and Berkshire — typically £300–£400 — and what influences how many days your job takes.",
    answer: "Kitchen fitting labour in Coventry, Warwickshire and Berkshire typically costs around £300–£400 per day. Install My Kitchen charges approximately £350 per day, with most kitchens taking between 3 and 10 days depending on size and complexity.",
  },
  {
    slug: "kitchen-installer-near-me-coventry",
    title: "Kitchen Installer Near Me — Coventry, Warwickshire & Berkshire",
    description: "Where Install My Kitchen is based, the areas we cover, and how to get in touch or book a survey.",
    answer: "Install My Kitchen is based in Coundon, Coventry and covers all Coventry postcodes plus Rugby, Nuneaton, Leamington Spa, Kenilworth, Warwick and surrounding Warwickshire areas. Call 07399 651836 or book a survey online.",
  },
  {
    slug: "kitchen-fitter-coventry",
    title: "Kitchen Fitter Coventry | Install My Kitchen",
    description: "Specialist independent kitchen fitting across all Coventry postcodes and Warwickshire from all major retailers.",
    answer: "Install My Kitchen is a specialist independent kitchen fitter based in Coventry, serving all Coventry postcodes and surrounding Warwickshire. We install kitchens from all major retailers including Wren, Howdens, Magnet and IKEA.",
  },
  {
    slug: "how-to-find-a-kitchen-fitter",
    title: "How to Find a Reliable Kitchen Fitter",
    description: "What to check, questions to ask, and red flags to avoid when choosing an independent fitter for your kitchen installation.",
    answer: "To find a reliable kitchen fitter: check they are experienced with your retailer's units, ask about the survey process, confirm what is and is not included, and get a fixed quote. Avoid fitters who quote without seeing the room.",
  },
  {
    slug: "independent-kitchen-installer-vs-retailer-fitter",
    title: "Independent Kitchen Installer vs Retailer Fitter — Which Is Better?",
    description: "An honest comparison of independent installers and retailer-appointed teams — costs, flexibility, loyalty, and what most retailers actually prefer.",
    answer: "An independent kitchen installer works for you, not the retailer, offering neutral advice, flexible scheduling and often more competitive pricing. Retailer fitters are tied to their own installation service and schedule. Most retailers welcome independent installers.",
  },
  {
    slug: "kitchen-installation-coventry-cost",
    title: "Kitchen Installation Cost in Coventry — 2025 Guide",
    description: "Coventry-specific cost guide covering small, medium and large kitchens, what drives prices up, and how to get a fixed quote.",
    answer: "Kitchen installation in Coventry typically costs £1,800–£7,500 depending on kitchen size. Small kitchens (8–12 units) from £1,800; medium (13–20 units) £2,800–£4,200; large (21+ units) from £4,200. Book a survey for an accurate quote.",
  },
  {
    slug: "what-size-kitchen-can-you-fit",
    title: "What Size Kitchen Can You Fit?",
    description: "From 6-unit galley kitchens to large open-plan kitchens with 30+ units. How we handle every layout including extensions.",
    answer: "We fit kitchens of all sizes — from compact galley kitchens with 6 units through to large open-plan kitchens with 30+ units. We also fit single rooms, extensions and barn conversions. Our survey confirms feasibility for any layout.",
  },
  {
    slug: "do-you-fit-worktops",
    title: "Do You Fit Worktops?",
    description: "Yes — laminate, solid wood, quartz, granite and compact laminate. How templating works for stone and what we supply directly.",
    answer: "Yes. We fit all worktop types including laminate, solid wood, quartz, granite and compact laminate. Templating for stone worktops is arranged separately — we co-ordinate with your worktop supplier. Laminate worktops can be supplied and fitted directly by us.",
  },
  {
    slug: "can-you-fit-appliances",
    title: "Can You Fit Appliances?",
    description: "Yes — ovens, hobs, dishwashers, washing machines, extractors and fridges. What requires a separate electrician and why.",
    answer: "Yes. We fit all built-in appliances including ovens, hobs, dishwashers, washing machines, extractor fans and fridges. Electrical connection of hardwired appliances (ovens, hobs) requires a qualified electrician, which we recommend you arrange separately.",
  },
  {
    slug: "what-happens-during-kitchen-survey",
    title: "What Happens During a Kitchen Installation Survey?",
    description: "Exactly what our surveyor checks in your home — dimensions, services, appliance positions, risks — and how the fixed quote is produced.",
    answer: "During our survey we check your room dimensions against your kitchen plan, assess walls, floors, ceiling height and access routes, confirm service positions, review appliance positions, identify any risks, and provide a fixed installation quote. The survey costs £195, credited back in full when you proceed.",
  },
  {
    slug: "kitchen-installation-warwickshire",
    title: "Kitchen Installation Warwickshire | Install My Kitchen",
    description: "Coverage across Rugby, Nuneaton, Leamington Spa, Kenilworth, Warwick, Stratford-upon-Avon and all Warwickshire areas.",
    answer: "Install My Kitchen covers all of Warwickshire including Rugby, Nuneaton, Leamington Spa, Kenilworth, Warwick, Stratford-upon-Avon, Southam and surrounding villages. We install kitchens from all major retailers.",
  },
  {
    slug: "shaker-kitchen-installation-coventry",
    title: "Shaker Kitchen Installation Coventry",
    description: "Shaker kitchen installation from Wren, Howdens, Magnet, IKEA and all major retailers across Coventry, Warwickshire and Berkshire.",
    answer: "Shaker kitchens are one of the most popular styles in Coventry, Warwickshire and Berkshire. Install My Kitchen installs shaker kitchens from Wren, Howdens, Magnet, IKEA and all major retailers. We handle the full installation including frames, doors, plinths and cornices.",
  },
  {
    slug: "how-to-book-kitchen-installation",
    title: "How to Book Kitchen Installation",
    description: "Step-by-step from survey to installation date — the booking process, deposit, and how to secure your slot.",
    answer: "To book a kitchen installation: book a survey (£195, credited back in full when you proceed). We visit your home, check the room and plans, then provide a fixed quote. Once you confirm with a deposit, we secure your installation date. Call 07399 651836 or book online.",
  },
];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
>
  <Header slot="header" />

  <div class="container py-6">
    <Breadcrumbs
      items={[
        { label: "Questions & Answers", href: "/answers/" },
      ]}
    />
  </div>

  <!-- Hero -->
  <section class="section" style="background: var(--bg-light);">
    <div class="container">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-5 leading-tight" style="color: var(--navy);">
          Kitchen Installation Questions &amp; Answers
        </h1>
        <p class="text-lg leading-relaxed" style="color: var(--text-soft);">
          Clear, straightforward answers to the questions homeowners ask most before booking a kitchen installation. No jargon, no fluff — just practical information from an experienced independent fitting team based in Coventry. Every question below has its real answer right on this page — click through for the full detail.
        </p>
      </div>
    </div>
  </section>

  <!-- Questions grid -->
  <section class="section">
    <div class="container">
      <div class="question-grid">
        {questions.map((q) => (
          <div class="question-card">
            <h2 class="question-card-title">
              <a href={`/answers/${q.slug}/`} class="question-card-title-link">{q.title}</a>
            </h2>
            <p class="question-card-answer">{q.answer}</p>
            <a href={`/answers/${q.slug}/`} class="question-card-more">
              Read the full answer
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    heading="Ready to Book Your Kitchen Installation?"
    subtext="Book a £195 pre-installation survey and get a fixed-price quote for your kitchen. The survey fee is credited back in full when you proceed."
    primaryLabel="Book Your Survey"
    primaryHref="/survey/"
    secondaryLabel="Call 07399 651836"
    secondaryHref="tel:07399651836"
    dark={true}
  />

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
  <BusinessSchema slot="schema" />
</Base>

<style>
  .question-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .question-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .question-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .question-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1.5px solid #E5E7EB;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .question-card:hover {
    border-color: var(--teal);
    box-shadow: 0 4px 18px rgba(15, 118, 110, 0.12);
  }

  .question-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--navy);
    margin: 0;
  }

  .question-card-title-link {
    color: inherit;
    text-decoration: none;
  }

  .question-card-title-link:hover,
  .question-card-title-link:focus-visible {
    color: var(--teal);
    text-decoration: underline;
  }

  .question-card-answer {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-soft);
    margin: 0;
  }

  .question-card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .question-card-more:hover,
  .question-card-more:focus-visible {
    text-decoration: underline;
  }

  .question-card-more svg {
    transition: transform 0.2s;
  }

  .question-card-more:hover svg {
    transform: translateX(3px);
  }
</style>
