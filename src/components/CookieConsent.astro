---
// Cookie consent banner — UK GDPR/PECR. Shown until the visitor makes a
// choice; the choice is stored in localStorage ('imk-cookie-consent') and
// read by the Consent Mode v2 bootstrap in Base.astro on every page load.
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
  <div class="cookie-banner-inner">
    <p class="cookie-banner-text">
      We use cookies to understand how visitors use this site (Google Analytics).
      Essential cookies are always on. See our
      <a href="/cookie-policy/">cookie policy</a> for details.
    </p>
    <div class="cookie-banner-actions">
      <button type="button" id="cookie-accept" class="cookie-btn cookie-btn-accept">Accept analytics</button>
      <button type="button" id="cookie-reject" class="cookie-btn cookie-btn-reject">Essential only</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var KEY = 'imk-cookie-consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) {}
    if (stored === 'granted' || stored === 'denied') return;
    banner.hidden = false;

    // Astro bundles inline scripts as modules, so the gtag() defined in the
    // layout head is not on window — push to dataLayer directly instead.
    function gtag() {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(arguments);
    }

    function choose(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      if (value === 'granted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
      banner.hidden = true;
    }

    document.getElementById('cookie-accept').addEventListener('click', function () { choose('granted'); });
    document.getElementById('cookie-reject').addEventListener('click', function () { choose('denied'); });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    background: var(--navy, #0f2a43);
    color: rgba(255, 255, 255, 0.92);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.25);
    padding: 1rem 1.25rem;
  }

  .cookie-banner-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.5rem;
    justify-content: space-between;
  }

  .cookie-banner-text {
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
    flex: 1 1 320px;
  }

  .cookie-banner-text a {
    color: #7dd3c8;
    text-decoration: underline;
  }

  .cookie-banner-actions {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    cursor: pointer;
    border: 1.5px solid transparent;
  }

  .cookie-btn-accept {
    background: var(--teal, #0f766e);
    color: #fff;
  }

  .cookie-btn-accept:hover {
    filter: brightness(1.1);
  }

  .cookie-btn-reject {
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .cookie-btn-reject:hover {
    border-color: rgba(255, 255, 255, 0.8);
    color: #fff;
  }

  @media (max-width: 560px) {
    .cookie-banner-actions {
      width: 100%;
    }
    .cookie-btn {
      flex: 1;
    }
  }
</style>
