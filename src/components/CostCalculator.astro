---
// Kitchen installation cost calculator: full-screen wizard, opens on trigger click.
// Lead capture (step 0) submits to Netlify Forms via fetch so the wizard can continue
// without a page navigation. Pricing uses fixed mid-range figures confirmed by Pindi
// (see calc-pricing below) rather than displaying raw ranges to the customer.
export interface Props {
  buttonLabel?: string;
}

const { buttonLabel = "Get an Instant Estimate" } = Astro.props;
---

<div data-calc-root>

<!-- Hidden static form so Netlify's build-time form detection registers "calculator-lead" -->
<form name="calculator-lead" data-netlify="true" netlify-honeypot="bot-field" hidden>
  <input type="text" name="bot-field" />
  <input type="text" name="name" />
  <input type="email" name="email" />
  <input type="tel" name="phone" />
  <input type="text" name="page" />
  <input type="text" name="estimate" />
</form>

<button type="button" class="calc-trigger" data-calc-open>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="12" y2="15"/></svg>
  {buttonLabel}
</button>

<div class="calc-overlay" data-calc-overlay hidden>
  <div class="calc-shell">
    <button type="button" class="calc-close" data-calc-close aria-label="Close calculator">&times;</button>

    <div class="calc-progress" data-calc-progress>
      <div class="calc-progress-bar" data-calc-progress-bar></div>
    </div>

    <div class="calc-body">

      <!-- Step 0: Lead capture -->
      <section class="calc-step" data-step="0">
        <h2>Let's get your estimate</h2>
        <p class="calc-sub">Just your details first, then a few quick questions about the kitchen.</p>
        <div class="calc-field">
          <label for="calc-name">Name</label>
          <input type="text" id="calc-name" data-field="name" required />
        </div>
        <div class="calc-field">
          <label for="calc-email">Email address</label>
          <input type="email" id="calc-email" data-field="email" required />
        </div>
        <div class="calc-field">
          <label for="calc-phone">Phone number</label>
          <input type="tel" id="calc-phone" data-field="phone" required />
        </div>
        <p class="calc-error" data-step-error hidden>Please fill in all three fields with a valid email.</p>
      </section>

      <!-- Step 1: Cabinets -->
      <section class="calc-step" data-step="1" hidden>
        <h2>How many cabinets?</h2>
        <div class="calc-stepper-row">
          <span>Base cabinets</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="baseCabinets">−</button>
            <span data-stepper-value="baseCabinets">0</span>
            <button type="button" data-stepper-plus="baseCabinets">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Wall cabinets</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="wallCabinets">−</button>
            <span data-stepper-value="wallCabinets">0</span>
            <button type="button" data-stepper-plus="wallCabinets">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Tall / larder cabinets</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="tallCabinets">−</button>
            <span data-stepper-value="tallCabinets">0</span>
            <button type="button" data-stepper-plus="tallCabinets">+</button>
          </div>
        </div>
      </section>

      <!-- Step 2: Appliances -->
      <section class="calc-step" data-step="2" hidden>
        <h2>What appliances are being fitted?</h2>
        <div class="calc-checks">
          <label class="calc-check"><input type="checkbox" data-field="applianceOven" /> Oven</label>
          <label class="calc-check"><input type="checkbox" data-field="applianceHob" /> Hob</label>
          <label class="calc-check"><input type="checkbox" data-field="applianceExtractor" /> Extractor</label>
          <label class="calc-check"><input type="checkbox" data-field="applianceDishwasher" /> Dishwasher</label>
          <label class="calc-check"><input type="checkbox" data-field="applianceWashingMachine" /> Washing machine</label>
          <label class="calc-check"><input type="checkbox" data-field="applianceFridgeFreezer" /> Fridge/freezer</label>
          <label class="calc-check"><input type="checkbox" data-field="applianceMicrowave" /> Microwave/combi</label>
        </div>
      </section>

      <!-- Step 3: Sink & tap -->
      <section class="calc-step" data-step="3" hidden>
        <h2>Sink &amp; tap</h2>
        <div class="calc-checks">
          <label class="calc-check"><input type="checkbox" data-field="sink" data-toggles="sinkTypeRow" /> Sink</label>
          <label class="calc-check"><input type="checkbox" data-field="tap" /> Tap</label>
          <label class="calc-check"><input type="checkbox" data-field="sinkCutout" /> Sink cut-out needed</label>
        </div>
        <div class="calc-field" data-row="sinkTypeRow" hidden>
          <label for="calc-sink-type">Sink type</label>
          <select id="calc-sink-type" data-field="sinkType">
            <option value="inset">Inset</option>
            <option value="undermount">Undermount</option>
          </select>
        </div>
      </section>

      <!-- Step 4: Worktops -->
      <section class="calc-step" data-step="4" hidden>
        <h2>Worktops</h2>
        <div class="calc-field">
          <label for="calc-worktop-material">Material</label>
          <select id="calc-worktop-material" data-field="worktopMaterial">
            <option value="laminate">Laminate</option>
            <option value="compact">Compact laminate</option>
            <option value="solidwood">Solid wood</option>
            <option value="stone">Quartz or stone</option>
          </select>
        </div>
        <div class="calc-stepper-row">
          <span>Number of lengths</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="worktopLengths">−</button>
            <span data-stepper-value="worktopLengths">1</span>
            <button type="button" data-stepper-plus="worktopLengths">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Number of joints</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="worktopJoints">−</button>
            <span data-stepper-value="worktopJoints">0</span>
            <button type="button" data-stepper-plus="worktopJoints">+</button>
          </div>
        </div>
        <label class="calc-check"><input type="checkbox" data-field="breakfastBar" /> Breakfast bar / island worktop</label>
        <p class="calc-note" data-note="worktopMaterialNote" hidden>Compact laminate, solid wood and stone/quartz worktops are templated and fitted by a specialist supplier — the figure shown is indicative until they've quoted.</p>
      </section>

      <!-- Step 5: Doors & Handles -->
      <section class="calc-step" data-step="5" hidden>
        <h2>Doors &amp; handles</h2>
        <div class="calc-checks calc-radio-group">
          <label class="calc-check"><input type="radio" name="calc-door-style" data-radio-group="doorStyle" value="handleless" /> Handleless</label>
          <label class="calc-check"><input type="radio" name="calc-door-style" data-radio-group="doorStyle" value="handled" /> With handles</label>
        </div>

        <div data-show-block="doorStyle-handleless" hidden>
          <div class="calc-checks calc-radio-group">
            <label class="calc-check"><input type="radio" name="calc-handleless-type" data-radio-group="handlelessType" value="jpull" /> J-pull doors</label>
            <label class="calc-check"><input type="radio" name="calc-handleless-type" data-radio-group="handlelessType" value="true" /> True handleless (recessed rail/profiles)</label>
          </div>

          <div data-show-block="handlelessType-true" hidden>
            <div class="calc-stepper-row">
              <span>Vertical profile (metres)</span>
              <div class="calc-stepper">
                <button type="button" data-stepper-minus="profileVerticalM">−</button>
                <span data-stepper-value="profileVerticalM">0</span>
                <button type="button" data-stepper-plus="profileVerticalM">+</button>
              </div>
            </div>
            <div class="calc-stepper-row">
              <span>Horizontal under-worktop profile (metres)</span>
              <div class="calc-stepper">
                <button type="button" data-stepper-minus="profileHorizontalM">−</button>
                <span data-stepper-value="profileHorizontalM">0</span>
                <button type="button" data-stepper-plus="profileHorizontalM">+</button>
              </div>
            </div>
            <div class="calc-stepper-row">
              <span>Drawer profile (metres)</span>
              <div class="calc-stepper">
                <button type="button" data-stepper-minus="profileDrawerM">−</button>
                <span data-stepper-value="profileDrawerM">0</span>
                <button type="button" data-stepper-plus="profileDrawerM">+</button>
              </div>
            </div>
            <div class="calc-stepper-row">
              <span>Internal corners</span>
              <div class="calc-stepper">
                <button type="button" data-stepper-minus="cornersInternal">−</button>
                <span data-stepper-value="cornersInternal">0</span>
                <button type="button" data-stepper-plus="cornersInternal">+</button>
              </div>
            </div>
            <div class="calc-stepper-row">
              <span>External corners</span>
              <div class="calc-stepper">
                <button type="button" data-stepper-minus="cornersExternal">−</button>
                <span data-stepper-value="cornersExternal">0</span>
                <button type="button" data-stepper-plus="cornersExternal">+</button>
              </div>
            </div>
            <label class="calc-check"><input type="checkbox" data-field="hasUnderPanels" data-toggles="underPanelsRow" /> Any under panels?</label>
            <div class="calc-stepper-row" data-row="underPanelsRow" hidden>
              <span>Number of under panels</span>
              <div class="calc-stepper">
                <button type="button" data-stepper-minus="underPanels">−</button>
                <span data-stepper-value="underPanels">0</span>
                <button type="button" data-stepper-plus="underPanels">+</button>
              </div>
            </div>
            <p class="calc-note">Profile and corner-fitting labour rates are indicative — a survey confirms the exact figures.</p>
          </div>
        </div>

        <div data-show-block="doorStyle-handled" hidden>
          <div class="calc-stepper-row">
            <span>Number of handles</span>
            <div class="calc-stepper">
              <button type="button" data-stepper-minus="handleCount">−</button>
              <span data-stepper-value="handleCount">0</span>
              <button type="button" data-stepper-plus="handleCount">+</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Step 6: Finishing items -->
      <section class="calc-step" data-step="6" hidden>
        <h2>Finishing items</h2>
        <div class="calc-stepper-row">
          <span>Wall end panels</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="wallEndPanels">−</button>
            <span data-stepper-value="wallEndPanels">0</span>
            <button type="button" data-stepper-plus="wallEndPanels">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Base end panels</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="baseEndPanels">−</button>
            <span data-stepper-value="baseEndPanels">0</span>
            <button type="button" data-stepper-plus="baseEndPanels">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Larder end panels</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="larderEndPanels">−</button>
            <span data-stepper-value="larderEndPanels">0</span>
            <button type="button" data-stepper-plus="larderEndPanels">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Decor panels</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="decorPanels">−</button>
            <span data-stepper-value="decorPanels">0</span>
            <button type="button" data-stepper-plus="decorPanels">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Fillers</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="fillers">−</button>
            <span data-stepper-value="fillers">0</span>
            <button type="button" data-stepper-plus="fillers">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Plinth (metres)</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="plinthMetres">−</button>
            <span data-stepper-value="plinthMetres">0</span>
            <button type="button" data-stepper-plus="plinthMetres">+</button>
          </div>
        </div>
        <div class="calc-stepper-row">
          <span>Cornice / pelmet (metres)</span>
          <div class="calc-stepper">
            <button type="button" data-stepper-minus="corniceMetres">−</button>
            <span data-stepper-value="corniceMetres">0</span>
            <button type="button" data-stepper-plus="corniceMetres">+</button>
          </div>
        </div>
      </section>

      <!-- Step 7: Existing kitchen -->
      <section class="calc-step" data-step="7" hidden>
        <h2>Existing kitchen</h2>
        <div class="calc-checks calc-radio-group">
          <label class="calc-check"><input type="radio" name="calc-removal" data-field="kitchenAlreadyRemoved" /> Kitchen already removed</label>
          <label class="calc-check"><input type="radio" name="calc-removal" data-field="imkToRemove" /> Install My Kitchen to remove the old kitchen</label>
        </div>
        <label class="calc-check"><input type="checkbox" data-field="wasteDisposal" /> Waste disposal required</label>
      </section>

      <!-- Step 8: Estimate -->
      <section class="calc-step" data-step="8" hidden>
        <h2>Your estimate</h2>
        <div class="calc-estimate-box">
          <p class="calc-estimate-range" data-estimate-range>£0–£0</p>
          <p class="calc-estimate-basis" data-estimate-basis></p>
        </div>
        <div class="calc-survey-note">
          <p>Every kitchen is different once you're actually in the room — it's worth getting a proper survey carried out by Install My Kitchen just to make sure everything will actually fit. A survey is <strong>£195</strong>, credited back in full when you book your installation.</p>
          <a href="/survey/" class="calc-survey-cta">Book Your Survey — £195</a>
        </div>
      </section>

    </div>

    <div class="calc-nav">
      <button type="button" class="btn-secondary" data-calc-back hidden>Back</button>
      <button type="button" class="btn-primary" data-calc-next>Continue</button>
    </div>
  </div>
</div>

</div>

<script>
  const RATES = {
    baseCabinet: 105,
    wallCabinet: 85,
    tallCabinet: 140,
    endDecorPanel: 65,
    corniceMetre: 30,
    plinthMetre: 25,
    worktopLength: { laminate: 100, compact: 180, solidwood: 140, stone: 300 },
    worktopJoint: 125,
    breakfastBar: 150,
    sink: 40,
    tap: 25,
    sinkCutout: 75,
    hobCutout: 65,
    dishwasher: 100,
    washingMachine: 100,
    fridgeFreezer: 125,
    oven: 75,
    hobFitting: 80,
    extractor: 115,
    microwave: 75,
    kitchenRemoval: 375,
    wasteRemoval: 225,
    wallEndPanel: 55,
    baseEndPanel: 65,
    larderEndPanel: 85,
    profileVerticalMetre: 35,
    profileHorizontalMetre: 30,
    profileDrawerMetre: 25,
    cornerFitting: 45,
    underPanel: 40,
    handle: 8,
  };

  function initCalculator(root) {
    const overlay = root.querySelector("[data-calc-overlay]");
    const openBtn = root.querySelector("[data-calc-open]");
    const closeBtn = root.querySelector("[data-calc-close]");
    const nextBtn = root.querySelector("[data-calc-next]");
    const backBtn = root.querySelector("[data-calc-back]");
    const progressBar = root.querySelector("[data-calc-progress-bar]");
    const steps = Array.from(root.querySelectorAll(".calc-step"));
    const stepError = root.querySelector("[data-step-error]");
    const TOTAL_STEPS = steps.length;

    const state = {
      name: "", email: "", phone: "",
      baseCabinets: 0, wallCabinets: 0, tallCabinets: 0,
      applianceOven: false, applianceHob: false, applianceExtractor: false,
      applianceDishwasher: false, applianceWashingMachine: false,
      applianceFridgeFreezer: false, applianceMicrowave: false,
      sink: false, tap: false, sinkCutout: false, sinkType: "inset",
      worktopMaterial: "laminate", worktopLengths: 1, worktopJoints: 0, breakfastBar: false,
      doorStyle: "", handlelessType: "",
      profileVerticalM: 0, profileHorizontalM: 0, profileDrawerM: 0,
      cornersInternal: 0, cornersExternal: 0, hasUnderPanels: false, underPanels: 0,
      handleCount: 0,
      wallEndPanels: 0, baseEndPanels: 0, larderEndPanels: 0,
      decorPanels: 0, fillers: 0, plinthMetres: 0, corniceMetres: 0,
      kitchenAlreadyRemoved: false, imkToRemove: false, wasteDisposal: false,
    };

    let current = 0;
    let leadSubmitted = false;

    function updateProgress() {
      progressBar.style.width = `${((current + 1) / TOTAL_STEPS) * 100}%`;
    }

    function showStep(i) {
      steps.forEach((s) => { s.hidden = Number(s.dataset.step) !== i; });
      backBtn.hidden = i === 0;
      nextBtn.textContent = i === TOTAL_STEPS - 1 ? "Done" : i === TOTAL_STEPS - 2 ? "See My Estimate" : "Continue";
      if (i === TOTAL_STEPS - 1) computeEstimate();
      updateProgress();
      stepError.hidden = true;
    }

    function validateLeadStep() {
      const nameOk = state.name.trim().length > 1;
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email.trim());
      const phoneOk = state.phone.trim().length >= 7;
      return nameOk && emailOk && phoneOk;
    }

    async function submitLead() {
      if (leadSubmitted) return;
      leadSubmitted = true;
      try {
        await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({
            "form-name": "calculator-lead",
            name: state.name, email: state.email, phone: state.phone,
            page: window.location.pathname,
          }).toString(),
        });
      } catch (e) {
        // Non-blocking — don't stop the wizard if the lead post fails.
        console.error("Calculator lead submit failed", e);
      }
    }

    function worktopRate() {
      return RATES.worktopLength[state.worktopMaterial] || RATES.worktopLength.laminate;
    }

    function computeEstimate() {
      let total = 0;
      total += state.baseCabinets * RATES.baseCabinet;
      total += state.wallCabinets * RATES.wallCabinet;
      total += state.tallCabinets * RATES.tallCabinet;
      if (state.applianceOven) total += RATES.oven;
      if (state.applianceHob) total += RATES.hobFitting;
      if (state.applianceExtractor) total += RATES.extractor;
      if (state.applianceDishwasher) total += RATES.dishwasher;
      if (state.applianceWashingMachine) total += RATES.washingMachine;
      if (state.applianceFridgeFreezer) total += RATES.fridgeFreezer;
      if (state.applianceMicrowave) total += RATES.microwave;
      if (state.sink) total += RATES.sink;
      if (state.tap) total += RATES.tap;
      if (state.sinkCutout) total += RATES.sinkCutout;
      total += state.worktopLengths * worktopRate();
      total += state.worktopJoints * RATES.worktopJoint;
      if (state.breakfastBar) total += RATES.breakfastBar;
      if (state.doorStyle === "handleless" && state.handlelessType === "true") {
        total += state.profileVerticalM * RATES.profileVerticalMetre;
        total += state.profileHorizontalM * RATES.profileHorizontalMetre;
        total += state.profileDrawerM * RATES.profileDrawerMetre;
        total += (state.cornersInternal + state.cornersExternal) * RATES.cornerFitting;
        if (state.hasUnderPanels) total += state.underPanels * RATES.underPanel;
      }
      if (state.doorStyle === "handled") total += state.handleCount * RATES.handle;
      total += state.wallEndPanels * RATES.wallEndPanel;
      total += state.baseEndPanels * RATES.baseEndPanel;
      total += state.larderEndPanels * RATES.larderEndPanel;
      total += state.decorPanels * RATES.endDecorPanel;
      total += state.fillers * RATES.endDecorPanel;
      total += state.plinthMetres * RATES.plinthMetre;
      total += state.corniceMetres * RATES.corniceMetre;
      if (state.imkToRemove) total += RATES.kitchenRemoval;
      if (state.wasteDisposal) total += RATES.wasteRemoval;

      const low = Math.round((total * 0.92) / 10) * 10;
      const high = Math.round((total * 1.08) / 10) * 10;
      const fmt = (n) => `£${n.toLocaleString("en-GB")}`;

      const totalCabinets = state.baseCabinets + state.wallCabinets + state.tallCabinets;
      const totalAppliances = [
        state.applianceOven, state.applianceHob, state.applianceExtractor,
        state.applianceDishwasher, state.applianceWashingMachine,
        state.applianceFridgeFreezer, state.applianceMicrowave,
      ].filter(Boolean).length;
      const materialLabel = { laminate: "laminate", compact: "compact laminate", solidwood: "solid wood", stone: "quartz/stone" }[state.worktopMaterial];

      const basisParts = [`${totalCabinets} cabinet${totalCabinets === 1 ? "" : "s"}`];
      if (totalAppliances) basisParts.push(`${totalAppliances} appliance${totalAppliances === 1 ? "" : "s"}`);
      basisParts.push(`${materialLabel} worktop${state.worktopLengths === 1 ? "" : "s"}`);
      if (state.worktopJoints) basisParts.push(`${state.worktopJoints} joint${state.worktopJoints === 1 ? "" : "s"}`);
      if (state.sink || state.sinkCutout) basisParts.push("sink installation");
      if (state.doorStyle === "handleless") {
        basisParts.push(state.handlelessType === "true" ? "true handleless profiles" : "J-pull doors");
      } else if (state.doorStyle === "handled" && state.handleCount) {
        basisParts.push(`${state.handleCount} handle${state.handleCount === 1 ? "" : "s"}`);
      }
      if (state.imkToRemove) basisParts.push("kitchen removal");

      root.querySelector("[data-estimate-range]").textContent = `${fmt(low)}–${fmt(high)}`;
      root.querySelector("[data-estimate-basis]").textContent = `Based on ${basisParts.join(", ")}.`;
      root.querySelector('input[name="estimate"]').value = `${fmt(low)}-${fmt(high)}`;

      // Update the hidden lead form's estimate field and re-submit a lightweight update.
      fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
          "form-name": "calculator-lead",
          name: state.name, email: state.email, phone: state.phone,
          page: window.location.pathname, estimate: `${fmt(low)}-${fmt(high)}`,
        }).toString(),
      }).catch(() => {});
    }

    function open() {
      overlay.hidden = false;
      document.body.style.overflow = "hidden";
      current = 0;
      showStep(current);
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = "";
    }

    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });

    // Text/email/tel/select field bindings
    root.querySelectorAll("[data-field]").forEach((el) => {
      const key = el.dataset.field;
      const sync = () => {
        if (el.type === "checkbox" || el.type === "radio") {
          state[key] = el.checked;
          if (el.dataset.toggles) {
            const row = root.querySelector(`[data-row="${el.dataset.toggles}"]`);
            if (row) row.hidden = !el.checked;
          }
        } else {
          state[key] = el.value;
        }
        if (key === "worktopMaterial") {
          const note = root.querySelector('[data-note="worktopMaterialNote"]');
          if (note) note.hidden = el.value === "laminate";
        }
      };
      el.addEventListener("input", sync);
      el.addEventListener("change", sync);
    });

    // Radio-group bindings — each group shows/hides a matching [data-show-block="group-value"]
    root.querySelectorAll("[data-radio-group]").forEach((el) => {
      const group = el.dataset.radioGroup;
      el.addEventListener("change", () => {
        if (!el.checked) return;
        state[group] = el.value;
        root.querySelectorAll(`[data-show-block^="${group}-"]`).forEach((block) => {
          block.hidden = block.dataset.showBlock !== `${group}-${el.value}`;
        });
      });
    });

    // Stepper bindings
    root.querySelectorAll("[data-stepper-plus]").forEach((btn) => {
      const key = btn.dataset.stepperPlus;
      btn.addEventListener("click", () => {
        state[key] = (state[key] || 0) + 1;
        root.querySelector(`[data-stepper-value="${key}"]`).textContent = state[key];
      });
    });
    root.querySelectorAll("[data-stepper-minus]").forEach((btn) => {
      const key = btn.dataset.stepperMinus;
      btn.addEventListener("click", () => {
        state[key] = Math.max(0, (state[key] || 0) - 1);
        root.querySelector(`[data-stepper-value="${key}"]`).textContent = state[key];
      });
    });

    nextBtn.addEventListener("click", async () => {
      if (current === 0) {
        if (!validateLeadStep()) { stepError.hidden = false; return; }
        await submitLead();
      }
      if (current === TOTAL_STEPS - 1) { close(); return; }
      current += 1;
      showStep(current);
    });

    backBtn.addEventListener("click", () => {
      if (current === 0) return;
      current -= 1;
      showStep(current);
    });
  }

  document.querySelectorAll("[data-calc-root]").forEach(initCalculator);
</script>

